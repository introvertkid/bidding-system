# ==============================
# DATABASE & CACHE (Docker & Backend)
# ==============================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=password123
DB_DATABASE=bidding_db

REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================
# BACKEND CONFIG
# ==============================
PORT=3000
JWT_SECRET=dev-secret-change-me
# Tự tạo dữ liệu demo khi database trống (đặt false để tắt)
SEED_DEMO_DATA=true

# ==============================
# FRONTEND CONFIG
# ==============================
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Địa chỉ backend để Next.js proxy /api/v1 và /uploads (trong Docker được ghi đè thành http://backend:3000)
BACKEND_URL=http://localhost:3000
